# Copy to .env and fill in. Never commit .env (NFR-11 / invariant 16).

DATABASE_URL=sqlite:///./data/route53.db
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true

# NFR-2 requires Secure on the session cookie. Keep true for any deployed
# environment (real HTTPS). Set to false only when testing locally over plain
# http://localhost — a Secure cookie set over http is silently never sent back.
COOKIE_SECURE=true
